# Supabase Vercel Marketplace normalmente injeta estas variáveis automaticamente.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Compatibilidade com nomes antigos, se sua conta ainda usar legacy keys:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# As transmissões desta versão usam apenas WebRTC P2P + STUN público.
# Nenhuma configuração TURN/SFU/Cloudflare é exigida nem contratada.

# Token secreto para proteger /api/hub-cleanup (não publicar no repositório real)
CRON_SECRET=
