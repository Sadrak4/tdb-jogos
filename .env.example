# Supabase Vercel Marketplace normalmente injeta estas variáveis automaticamente.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Compatibilidade com nomes antigos, se sua conta ainda usar legacy keys:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Pesquisa do YouTube continua opcional.
YOUTUBE_API_KEY=
